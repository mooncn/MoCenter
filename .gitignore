# 构建产物（scripts/build-linux-all.sh 与 scripts/build-all.bat 统一输出到这里）
build/
dist/
*.exe
mocenter-server
mocenter-agent
mocenter-server.exe
mocenter-agent.exe

# 安装程序打包产物（由 scripts/build-windows-installer.bat 生成）
# payload/ 下的二进制与 web/ 都是可再生成的；该目录只有 README.md 是手写源文件。
installer/installer
installer/payload/*
!installer/payload/README.md

# Go
*.test
*.out
vendor/

# 安全：私钥/证书（测试生成）
certs/
*.key
*.pem
*.crt

# 临时诊断目录
_diag/
_diag*/
_obf/
.testtools/

# 服务端托管的安装包/二进制（UltraVNC 安装包、x11vnc 二进制等，体积大且可自行获取）
# 注意：Windows 包恰好被上面的 *.exe 覆盖，但 Linux 的 x11vnc-linux-* 不会，故需显式忽略。
packages/

# 运行时数据（敏感，不纳入版本控制）
server/audits.jsonl
server/users.json
*.db
*.db-shm
*.db-wal

# AI 助手本机记忆/工作日志（含本机路径与临时状态，不纳入版本控制）
.codefree/
.workbuddy/
.workbuddy-ai/

# Node
node_modules/
npm-debug.log*

# 系统/编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
