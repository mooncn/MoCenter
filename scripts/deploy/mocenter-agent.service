# MoCenter Agent systemd 服务单元（打包时装入 /lib/systemd/system/）
# 由 scripts/build-linux-all.sh 与 scripts/deploy/install-linux.sh 共用，避免两处各写一份。
[Unit]
Description=MoCenter Agent (集中式主机远控管理被控端)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/mocenter/mocenter-agent.conf
# ⚠️ 必须显式指定 -config：默认配置路径是"可执行文件同目录"（即 /usr/local/bin），
#    那里不适合放运行期数据 —— 配置、creds 与**单实例锁文件**都会落在 /etc/mocenter。
#    锁文件必须与配置文件同目录（见 internal/winapp/singleton_unix.go 的说明）：
#    放在 /usr/local/bin 会让"以 root 跑服务 + 以普通用户跑 cron 保活"这种
#    最常见的组合拿不到同一把锁（目录不可写 → 降级放行 → 又出现重复实例）。
ExecStart=/usr/local/bin/mocenter-agent -config "${MOCENTER_CONFIG}" -server "${MOCENTER_SERVER}" -agentid "${MOCENTER_AGENT_ID}" -proxy-ip "${MOCENTER_PROXY_IP}" -daemon
Restart=always
RestartSec=5
# 停止时给足时间优雅退出（关闭已有隧道 / 释放锁），避免 systemd 直接 SIGKILL 后
# 与"手工启动的新实例"短暂并存。
TimeoutStopSec=20
LimitNOFILE=1048576
# 沙箱：只挑**不打断 Agent 本职**的那一档。
#   · NoNewPrivileges：进程树不能再借 setuid 程序提权。Agent 本来就以 root 运行，
#     这一项挡的是"被拿下的 Agent 换一条 setuid 路径去执行"，而 root 主动降权跑
#     普通用户命令（su/sudo -u）不受影响，运维功能不变。
# 刻意**不加**的几项，以及原因（加错了不会报障，只会静默把功能打断）：
#   · PrivateTmp：Agent 的活是"替运维在这台机上执行"，私有 /tmp 会让它写进去的文件
#     在 SSH 里凭空消失，Linux 的 X11 socket（/tmp/.X11-unix）也与 VNC 抓取相关；
#   · ProtectSystem / ProtectHome / ReadOnlyPaths：Agent 要写 /etc/mocenter
#     （配置、凭据、单实例锁），还要替换 /usr/local/bin 下的自身（远程升级）；
#   · ProtectKernelTunables / RestrictAddressFamilies：远程命令调这些是常态。
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
